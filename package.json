{
  "name": "lunara",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "dev:api": "tsc -p tsconfig.server.json && node dist-server/server/index.js",
    "build": "tsc --noEmit && vite build --configLoader runner && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-isolation=none .test-build/tests/*.test.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
